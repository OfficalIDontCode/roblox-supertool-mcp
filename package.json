{
  "name": "roblox-supertool-mcp",
  "version": "0.5.0",
  "description": "Unified MCP server for Roblox Studio: scripts, workspace, bulk ops, spatial queries, animation, sync, viewport.",
  "type": "module",
  "bin": {
    "roblox-supertool-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && shx chmod +x build/*.js || true",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.6.0"
  }
}
